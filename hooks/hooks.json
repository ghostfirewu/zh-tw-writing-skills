{
  "description": "繁中守門：Write/Edit 寫入的新內容有簡體殘留時提醒 Claude（偵測不阻擋）",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
